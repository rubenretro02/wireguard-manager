# ===== Supabase (ya existentes) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Telegram Mini App =====
# Token del bot de la tienda (@BotFather)
TELEGRAM_BOT_TOKEN=
# Token del bot de agents (opcional) — los que entren por este bot se registran
# como 'agent' (sin tienda, solo gestión de sus peers)
TELEGRAM_AGENT_BOT_TOKEN=
# Secreto arbitrario para validar el webhook del bot (opcional pero recomendado)
TELEGRAM_WEBHOOK_SECRET=
# URL pública de la app desplegada (sin slash final), ej: https://tuapp.vercel.app
NEXT_PUBLIC_APP_URL=
# Bot de soporte (sin @) — botón Support de la Mini App. Default: blackgoatsupport_bot
NEXT_PUBLIC_SUPPORT_BOT=

# ===== Cryptomus (https://app.cryptomus.com → Settings → API) =====
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=

# ===== Cron =====
# Secreto para /api/cron/expire-customer-peers (Authorization: Bearer <secret>)
CRON_SECRET=
